---
import '../styles/global.css'
import { cv } from '../data/cv'

interface Props {
    title?: string
    description?: string
}

const { basics } = cv
const currentPage = Astro.url.pathname

const navItems = [
    { label: 'Home', href: '/' },
    { label: 'Projects', href: '/projects' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
]

const isActive = (href: string) =>
    href === '/' ? currentPage === '/' : currentPage.startsWith(href)

const defaultDescription = `${basics.label} based in ${basics.location}. ${basics.summary}`
const { title, description = defaultDescription } = Astro.props

const siteTitle = `${basics.name} — Software Engineer & Tech Lead`
const fullTitle = title ? `${title} | ${basics.name}` : siteTitle

const github = basics.profiles.find((p) => p.network === 'GitHub')
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')
const initials = basics.name
    .split(' ')
    .map((n) => n[0])
    .join('')
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={basics.website} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-gray-50 text-body min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-6 md:px-6 md:py-10 lg:flex lg:gap-8">
      <!-- Sidebar / profile -->
      <aside class="lg:w-72 lg:flex-shrink-0">
        <div class="lg:sticky lg:top-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-0">
            <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent to-accent-dark text-2xl font-bold text-white lg:mb-4 lg:h-20 lg:w-20 lg:text-3xl">
              {initials}
            </div>
            <div>
              <h1 class="text-xl font-bold text-ink lg:text-2xl">{basics.name}</h1>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent-dark">{basics.label}</p>
            </div>
          </div>

          <p class="mt-4 flex items-center gap-2 text-sm text-muted">
            <svg class="h-4 w-4 fill-accent" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            {basics.location}
          </p>

          <!-- Social links -->
          <div class="mt-4 flex gap-3">
            <a href={`mailto:${basics.email}`} aria-label="Email" class="text-muted transition-colors hover:text-accent">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </a>
            {github && (
              <a href={github.url} aria-label="GitHub" class="text-muted transition-colors hover:text-accent">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
            )}
            {linkedin && (
              <a href={linkedin.url} aria-label="LinkedIn" class="text-muted transition-colors hover:text-accent">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            )}
          </div>

          <!-- Navigation -->
          <nav class="mt-6 border-t border-gray-100 pt-4">
            <ul class="flex flex-wrap gap-x-1 gap-y-1 lg:flex-col">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={`block rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                      isActive(item.href)
                        ? 'bg-accent-light text-accent-dark'
                        : 'text-gray-600 hover:bg-gray-50 hover:text-accent'
                    }`}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <a
            href="/cv.pdf"
            class="mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-dark"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg>
            Download CV
          </a>
        </div>
      </aside>

      <!-- Main content -->
      <main class="mt-6 min-w-0 flex-1 lg:mt-0">
        <slot />
      </main>
    </div>

    <footer class="border-t border-gray-200 py-8">
      <div class="mx-auto max-w-6xl px-6 text-center text-sm text-muted">
        <p>&copy; {new Date().getFullYear()} {basics.name}. Built with Astro &amp; Tailwind CSS.</p>
      </div>
    </footer>
  </body>
</html>
