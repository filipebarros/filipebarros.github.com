---
import Layout from '../layouts/Layout.astro'
import { cv } from '../data/cv'

const { basics } = cv

// Posts will be sourced from an Astro content collection (src/content/blog/*.md).
// Until then, this renders a tidy empty state.
interface Post {
    title: string
    excerpt: string
    date: string
    readTime: string
    tags: string[]
    slug: string
}
const posts: Post[] = []

const formatDate = (date: string) =>
    new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
---

<Layout title="Blog" description={`Writing and notes by ${basics.name}.`}>
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-2xl font-bold text-ink">Blog</h2>
    <p class="mt-2 text-body">Notes on engineering, leadership and things I'm learning.</p>
  </section>

  {posts.length > 0 ? (
    <div class="mt-8 space-y-4">
      {posts.map((post) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
            <time>{formatDate(post.date)}</time>
            <span>·</span>
            <span>{post.readTime}</span>
          </div>
          <h3 class="mt-2 text-lg font-bold text-ink">
            <a href={`/blog/${post.slug}`} class="transition-colors hover:text-accent">{post.title}</a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-body">{post.excerpt}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {post.tags.map((tag) => (
              <span class="rounded-full bg-accent-light px-3 py-1 text-xs font-medium text-accent-dark">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-8 rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center shadow-sm">
      <p class="text-body">No posts yet — first one is in the works.</p>
    </div>
  )}
</Layout>
