---
import Layout from '../layouts/Layout.astro'
import { cv } from '../data/cv'

const { basics, work, skills, education } = cv
---

<Layout>
  <!-- About -->
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-2xl font-bold text-ink">Hi, I'm {basics.name.split(' ')[0]}.</h2>
    <p class="mt-3 leading-relaxed text-body">{basics.summary}</p>
  </section>

  <!-- Experience -->
  <section class="mt-8">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold uppercase tracking-wide text-accent-dark">
      <span class="h-5 w-1.5 rounded-full bg-accent"></span>
      Experience
    </h2>

    <div class="space-y-4">
      {work.map((job) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <div>
              <h3 class="text-lg font-bold text-ink">{job.company}</h3>
              <p class="font-semibold text-accent-dark">{job.role}</p>
            </div>
            <span class="whitespace-nowrap text-sm text-muted">{job.start} – {job.end}</span>
          </div>
          <p class="mt-2 text-sm italic text-muted">{job.summary}</p>
          <ul class="mt-3 space-y-2">
            {job.highlights.map((point) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-body">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="mt-8">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold uppercase tracking-wide text-accent-dark">
      <span class="h-5 w-1.5 rounded-full bg-accent"></span>
      Technical Skills
    </h2>
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <dl class="space-y-4">
        {skills.map((group) => (
          <div class="grid gap-1 sm:grid-cols-[170px_1fr] sm:gap-4">
            <dt class="font-bold text-ink">{group.category}</dt>
            <dd class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full bg-accent-light px-3 py-1 text-xs font-medium text-accent-dark">{item}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Education -->
  <section class="mt-8">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold uppercase tracking-wide text-accent-dark">
      <span class="h-5 w-1.5 rounded-full bg-accent"></span>
      Education
    </h2>
    <div class="space-y-4">
      {education.map((edu) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-bold text-ink">{edu.institution}</h3>
            <span class="whitespace-nowrap text-sm text-muted">{edu.start} – {edu.end}</span>
          </div>
          <p class="mt-1 text-sm text-body">
            {edu.qualification}{edu.detail && <span class="text-muted"> · {edu.detail}</span>}
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>
