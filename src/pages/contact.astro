---
import Layout from '../layouts/Layout.astro'
import { cv } from '../data/cv'

const { basics } = cv
const github = basics.profiles.find((p) => p.network === 'GitHub')
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')

const channels = [
    {
        label: 'Email',
        value: basics.email,
        href: `mailto:${basics.email}`,
        icon: 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
    },
    github && {
        label: 'GitHub',
        value: `@${github.username}`,
        href: github.url,
        icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
    },
    linkedin && {
        label: 'LinkedIn',
        value: `in/${linkedin.username}`,
        href: linkedin.url,
        icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    },
].filter(Boolean) as { label: string; value: string; href: string; icon: string }[]
---

<Layout title="Contact" description={`Get in touch with ${basics.name}.`}>
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-2xl font-bold text-ink">Get in touch</h2>
    <p class="mt-2 max-w-2xl text-body">
      Always happy to talk about engineering, leadership or interesting problems. The
      quickest way to reach me is by email — or find me on the platforms below.
    </p>
  </section>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    {channels.map((c) => (
      <a
        href={c.href}
        class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
      >
        <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-accent-light text-accent-dark">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d={c.icon} /></svg>
        </span>
        <span>
          <span class="block text-sm font-semibold text-ink">{c.label}</span>
          <span class="block text-sm text-muted">{c.value}</span>
        </span>
      </a>
    ))}
  </div>
</Layout>
