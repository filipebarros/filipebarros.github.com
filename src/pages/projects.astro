---
import Layout from '../layouts/Layout.astro'
import { cv } from '../data/cv'

const { projects, basics } = cv
const github = basics.profiles.find((p) => p.network === 'GitHub')
---

<Layout title="Projects" description={`Selected work and open-source projects by ${basics.name}.`}>
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
    <h2 class="text-2xl font-bold text-ink">Projects</h2>
    <p class="mt-2 text-body">Selected work, experiments and open-source contributions.</p>
  </section>

  {projects.length > 0 ? (
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="text-lg font-bold text-ink">{project.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-body">{project.description}</p>
          {project.tags && (
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full bg-accent-light px-3 py-1 text-xs font-medium text-accent-dark">{tag}</span>
              ))}
            </div>
          )}
          {project.url && (
            <a href={project.url} class="mt-4 text-sm font-semibold text-accent transition-colors hover:text-accent-dark">
              View project →
            </a>
          )}
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-8 rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center shadow-sm">
      <p class="text-body">A curated set of projects is on the way.</p>
      {github && (
        <a
          href={github.url}
          class="mt-5 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-dark"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          See my work on GitHub
        </a>
      )}
    </div>
  )}
</Layout>
